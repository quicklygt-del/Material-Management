# 複製為 .env.local 後填入（需 NEXT_PUBLIC_ 前綴才能在瀏覽器端使用）
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# 標籤 QR 第一段前綴（單機預設 WMS；未設定時可沿用舊變數）
NEXT_PUBLIC_LABEL_PREFIX=WMS
# 相容舊名稱（未設 NEXT_PUBLIC_LABEL_PREFIX 時使用）
# NEXT_PUBLIC_TENANT_ID=

# 標籤紀錄寫入 API 用（僅伺服器／部署環境，切勿加上 NEXT_PUBLIC_）
SUPABASE_SERVICE_ROLE_KEY=

# 相容舊命名（可選，程式會優先讀 NEXT_PUBLIC_*）
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
