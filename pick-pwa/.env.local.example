# 複製為 .env.local 後填入（需 NEXT_PUBLIC_ 前綴才能在瀏覽器端使用）
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# 標籤 QR 第一段前綴（單機預設 WMS；未設定時可沿用舊變數）
NEXT_PUBLIC_LABEL_PREFIX=WMS
# 相容舊名稱（未設 NEXT_PUBLIC_LABEL_PREFIX 時使用）
# NEXT_PUBLIC_=

# storage_zones 的租戶範圍欄位：資料庫已將  改為 company_id 時設為 company_id（預設 ）
# NEXT_PUBLIC_STORAGE_ZONES_SCOPE_COLUMN=company_id

# 【必填】伺服端 API（/api/warehouses、label-records、ledger 等）— 無此金鑰會回 503
# Supabase Dashboard → Project Settings → API → Project API keys → service_role（secret）
# 僅存於伺服器／Vercel Environment Variables，切勿加上 NEXT_PUBLIC_（否則會外洩到瀏覽器）
SUPABASE_SERVICE_ROLE_KEY=

# Super Admin 總控台（獨立於租戶帳號；務必強密碼＋強 JWT 金鑰）
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_JWT_SECRET=

# 相容舊命名（可選，程式會優先讀 NEXT_PUBLIC_*）
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
